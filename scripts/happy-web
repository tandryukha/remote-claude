#!/bin/bash
# Start the self-hosted Happy web UI
#
# Usage: happy-web [API_TUNNEL_URL]
#   If no URL provided, uses localhost (for local testing only)
#   For mobile access, provide the tunneled API URL:
#   Example: happy-web https://xxx-yyy-zzz.trycloudflare.com

API_URL="${1:-http://localhost:3005}"
export EXPO_PUBLIC_SERVER_URL="$API_URL"

echo "Starting Happy Web UI..."
echo "API URL: $API_URL"
echo ""

cd ~/happy/packages/happy-app && yarn web
