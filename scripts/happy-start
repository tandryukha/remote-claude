#!/bin/bash
# Start everything for mobile Claude access with one command

echo "========================================"
echo "Starting Happy Mobile Access"
echo "========================================"
echo ""

# Cleanup temp files
rm -f /tmp/happy-api-url.txt /tmp/happy-web-url.txt

# 1. Ensure Happy Server is running
echo "[1/4] Starting Happy Server..."
cd ~/happy-server
if docker-compose ps 2>/dev/null | grep -q "Up"; then
    echo "      Already running"
else
    docker-compose up -d 2>/dev/null
    sleep 3
fi

# Verify server is healthy
if ! curl -s http://localhost:3005/health > /dev/null 2>&1; then
    echo "ERROR: Happy Server not responding. Run: cd ~/happy-server && docker-compose up -d"
    exit 1
fi
echo "      OK - http://localhost:3005"
echo ""

# 2. Start API tunnel in background
echo "[2/4] Starting API tunnel..."
cloudflared tunnel --url http://localhost:3005 > /tmp/happy-api-tunnel.log 2>&1 &
API_PID=$!

# Wait for URL to appear in log
for i in {1..30}; do
    if grep -q "trycloudflare.com" /tmp/happy-api-tunnel.log 2>/dev/null; then
        API_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/happy-api-tunnel.log | head -1)
        break
    fi
    sleep 1
done

if [ -z "$API_URL" ]; then
    echo "ERROR: Failed to get API tunnel URL. Check /tmp/happy-api-tunnel.log"
    cat /tmp/happy-api-tunnel.log
    kill $API_PID 2>/dev/null
    exit 1
fi
echo "      $API_URL"
echo ""

# 3. Start Web UI with tunneled API
echo "[3/4] Starting Happy Web UI..."
cd ~/happy/packages/happy-app
EXPO_PUBLIC_SERVER_URL="$API_URL" yarn web > /tmp/happy-web.log 2>&1 &
WEB_PID=$!

# Wait for web server to start
for i in {1..30}; do
    if curl -s http://localhost:8081 > /dev/null 2>&1; then
        break
    fi
    sleep 1
done
echo "      http://localhost:8081"
echo ""

# 4. Start Web UI tunnel
echo "[4/4] Starting Web UI tunnel..."
cloudflared tunnel --url http://localhost:8081 > /tmp/happy-web-tunnel.log 2>&1 &
WEB_TUNNEL_PID=$!

# Wait for URL
for i in {1..30}; do
    if grep -q "trycloudflare.com" /tmp/happy-web-tunnel.log 2>/dev/null; then
        WEB_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/happy-web-tunnel.log | head -1)
        break
    fi
    sleep 1
done

if [ -z "$WEB_URL" ]; then
    echo "ERROR: Failed to get Web tunnel URL. Check /tmp/happy-web-tunnel.log"
    cat /tmp/happy-web-tunnel.log
    exit 1
fi

# Done!
echo ""
echo "========================================"
echo "READY! Open this URL on your phone:"
echo ""
echo "  $WEB_URL"
echo ""
echo "$WEB_URL" | pbcopy
echo "(Copied to clipboard)"
echo "========================================"
echo ""
echo "Now run 'calorie' or 'dropship' in another terminal."
echo "Press Ctrl+C to stop all services."
echo ""

# Handle cleanup on exit
cleanup() {
    echo ""
    echo "Stopping services..."
    kill $API_PID $WEB_PID $WEB_TUNNEL_PID 2>/dev/null
    pkill -f "cloudflared tunnel" 2>/dev/null
    echo "Done"
    exit 0
}
trap cleanup INT TERM

# Keep script running
wait
