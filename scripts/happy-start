#!/bin/bash
# Start everything for mobile Claude access with one command

echo "========================================"
echo "Starting Happy Mobile Access"
echo "========================================"
echo ""

# Cleanup
rm -f /tmp/happy-api-tunnel.log /tmp/happy-web-tunnel.log /tmp/happy-web.log
pkill -f "cloudflared tunnel" 2>/dev/null

# 1. Ensure Happy Server is running
echo "[1/4] Starting Happy Server..."
cd ~/happy-server
if docker-compose ps 2>/dev/null | grep -q "Up"; then
    echo "      Already running"
else
    docker-compose up -d 2>/dev/null
    sleep 3
fi

if ! curl -s http://localhost:3005/health > /dev/null 2>&1; then
    echo "ERROR: Happy Server not responding"
    echo "Run: cd ~/happy-server && docker-compose up -d"
    exit 1
fi
echo "      OK"
echo ""

# 2. Start API tunnel
echo "[2/4] Starting API tunnel (takes ~10s)..."
cloudflared tunnel --url http://localhost:3005 > /tmp/happy-api-tunnel.log 2>&1 &
API_PID=$!

API_URL=""
for i in {1..45}; do
    # Look for actual URL in the box output
    API_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/happy-api-tunnel.log 2>/dev/null | head -1)
    if [ -n "$API_URL" ]; then
        break
    fi
    sleep 1
done

if [ -z "$API_URL" ]; then
    echo "ERROR: Tunnel failed"
    cat /tmp/happy-api-tunnel.log
    kill $API_PID 2>/dev/null
    exit 1
fi
echo "      $API_URL"
echo ""

# 3. Start Web UI
echo "[3/4] Starting Web UI..."
cd ~/happy/packages/happy-app
EXPO_PUBLIC_SERVER_URL="$API_URL" yarn web > /tmp/happy-web.log 2>&1 &
WEB_PID=$!

# Wait for web server
for i in {1..45}; do
    if curl -s http://localhost:8081 > /dev/null 2>&1; then
        break
    fi
    sleep 1
done

if ! curl -s http://localhost:8081 > /dev/null 2>&1; then
    echo "ERROR: Web UI failed to start"
    cat /tmp/happy-web.log | tail -20
    exit 1
fi
echo "      OK"
echo ""

# 4. Start Web UI tunnel
echo "[4/4] Starting Web UI tunnel (takes ~10s)..."
cloudflared tunnel --url http://localhost:8081 > /tmp/happy-web-tunnel.log 2>&1 &
WEB_TUNNEL_PID=$!

WEB_URL=""
for i in {1..45}; do
    WEB_URL=$(grep -oE 'https://[a-z0-9-]+\.trycloudflare\.com' /tmp/happy-web-tunnel.log 2>/dev/null | head -1)
    if [ -n "$WEB_URL" ]; then
        break
    fi
    sleep 1
done

if [ -z "$WEB_URL" ]; then
    echo "ERROR: Web tunnel failed"
    cat /tmp/happy-web-tunnel.log
    exit 1
fi

# Save URLs for other scripts
echo "$API_URL" > /tmp/happy-api-url
echo "$WEB_URL" > /tmp/happy-web-url

# Done!
echo ""
echo "========================================"
echo "READY! Open on your phone:"
echo ""
echo "  $WEB_URL"
echo ""
echo "$WEB_URL" | pbcopy
echo "(Copied to clipboard)"
echo "========================================"
echo ""
echo "Run 'calorie' or 'dropship' in another terminal."
echo "Press Ctrl+C to stop."
echo ""

cleanup() {
    echo ""
    echo "Stopping..."
    kill $API_PID $WEB_PID $WEB_TUNNEL_PID 2>/dev/null
    pkill -f "cloudflared tunnel" 2>/dev/null
    echo "Done"
    exit 0
}
trap cleanup INT TERM

wait
